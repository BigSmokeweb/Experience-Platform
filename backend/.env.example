# Server
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://experience-platform-sigma.vercel.app,http://localhost:3000

# Database (Supabase PostgreSQL with PostGIS)
# Transaction pooler (Port 6543) for runtime queries:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (Port 5432) for schema migrations:
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Redis (Session / Rate Limiting / Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (15 min access, 7 day refresh)
JWT_ACCESS_SECRET="production-grade-super-secret-access-token-key-change-in-env"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="production-grade-super-secret-refresh-token-key-change-in-env"
JWT_REFRESH_EXPIRATION="7d"

# Storage Configuration (Private bucket for KYC documents, Public bucket for Experience media)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_PUBLIC_BUCKET="experience-public-media"
STORAGE_PRIVATE_KYC_BUCKET="provider-kyc-documents-restricted"
STORAGE_SIGNED_URL_EXPIRY_SECONDS=900

# AI Provider (Gemini / Isolated Proxy)
GEMINI_API_KEY=""
AI_SERVICE_ENABLED=true

# Security & Rate Limiting (Redis Token Bucket)
RATE_LIMIT_GLOBAL_TTL=60
RATE_LIMIT_GLOBAL_LIMIT=100
RATE_LIMIT_AUTH_LIMIT=5
RATE_LIMIT_SEARCH_LIMIT=30

# Weather API (uses Open-Meteo by default — no API key required)
# Set WEATHER_API_KEY only if switching to a different provider (e.g., OpenWeatherMap)
WEATHER_API_KEY=""

# Trip Session Privacy — GPS purge threshold for abandoned sessions (hours)
SESSION_ABANDON_HOURS=6
