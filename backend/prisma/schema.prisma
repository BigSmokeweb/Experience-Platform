datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp"), pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  TRAVELER
  PROVIDER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum Category {
  FOOD
  CULTURE
  ADVENTURE
  HIDDEN_GEMS
  NIGHTLIFE
  EVENTS
  WORKSHOPS
  SHOPPING
}

enum BudgetBand {
  BUDGET
  MODERATE
  PREMIUM
  LUXURY
}

enum EventType {
  VIEW
  SAVE
  CLICK
  COMPLETE
}

enum KycDocumentType {
  BUSINESS_REGISTRATION
  GOVERNMENT_ID
  GST_CERTIFICATE
}

enum TripSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum WeatherTag {
  INDOOR
  OUTDOOR
  WEATHER_DEPENDENT
}

model User {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String            @unique
  passwordHash    String            @map("password_hash")
  role            Role              @default(TRAVELER)
  name            String
  mfaEnabled      Boolean           @default(false) @map("mfa_enabled")
  mfaSecret       String?           @map("mfa_secret")
  refreshTokenHash String?          @map("refresh_token_hash")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  travelerProfile TravelerProfile?
  providerProfile ProviderProfile?
  reviews         Review[]
  interactions    Interaction[]
  tripSessions    TripSession[]

  @@map("users")
}

model TravelerProfile {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String      @unique @map("user_id") @db.Uuid
  homeCity    String?     @map("home_city")
  interests   Category[]  @default([])
  budgetBand  BudgetBand  @default(MODERATE) @map("budget_band")
  travelStyle String?     @map("travel_style")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("traveler_profiles")
}

model ProviderProfile {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  businessName       String             @map("business_name")
  businessType       String             @map("business_type")
  phone              String
  city               String
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  kycDocumentRef     String?            @map("kyc_document_ref") // Storage key in private KYC bucket
  kycDocumentType    KycDocumentType?   @map("kyc_document_type")
  kycSubmittedAt     DateTime?          @map("kyc_submitted_at")
  kycVerifiedAt      DateTime?          @map("kyc_verified_at")
  kycRejectionReason String?            @map("kyc_rejection_reason")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences Experience[]

  @@map("provider_profiles")
}

model Experience {
  id                 String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId         String                               @map("provider_id") @db.Uuid
  title              String
  description        String
  category           Category
  location           Unsupported("geography(Point,4326)") // PostGIS Point (Longitude, Latitude)
  latitude           Float
  longitude          Float
  address            String
  city               String
  state              String
  country            String                               @default("India")
  priceMin           Float                                @map("price_min")
  priceMax           Float                                @map("price_max")
  currency           String                               @default("INR")
  budgetBand         BudgetBand                           @map("budget_band")
  accessibilityTags  String[]                             @default([]) @map("accessibility_tags")
  mediaUrls          String[]                             @default([]) @map("media_urls")
  availabilityRules  Json                                 @map("availability_rules") // Structured JSON
  durationMinutes    Int                                  @default(120) @map("duration_minutes")
  qualityScore       Float                                @default(0.8) @map("quality_score")
  ratingAverage      Float                                @default(0.0) @map("rating_average")
  reviewCount        Int                                  @default(0) @map("review_count")
  authenticityRating Float                                @default(0.85) @map("authenticity_rating")
  weatherTag         WeatherTag                           @default(WEATHER_DEPENDENT) @map("weather_tag")
  isActive           Boolean                              @default(true) @map("is_active")
  published          Boolean                              @default(true) @map("published")
  createdAt          DateTime                             @default(now()) @map("created_at")
  updatedAt          DateTime                             @updatedAt @map("updated_at")

  provider     ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviews      Review[]
  interactions Interaction[]

  @@index([city])
  @@index([category])
  @@index([budgetBand])
  @@map("experiences")
}

model Review {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experienceId         String   @map("experience_id") @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  interactionId        String   @unique @map("interaction_id") @db.Uuid // Strictly tied to verified completion
  ratingOverall        Int      @map("rating_overall") // 1-5
  ratingAuthenticity   Int      @map("rating_authenticity")
  ratingValue          Int      @map("rating_value")
  ratingExperience     Int      @map("rating_experience")
  ratingAccessibility  Int      @map("rating_accessibility")
  text                 String   // Sanitized UGC
  isModerated          Boolean  @default(true) @map("is_moderated")
  createdAt            DateTime @default(now()) @map("created_at")

  experience  Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interaction Interaction @relation(fields: [interactionId], references: [id], onDelete: Restrict)

  @@index([experienceId])
  @@map("reviews")
}

model Interaction {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  experienceId String    @map("experience_id") @db.Uuid
  eventType    EventType @map("event_type")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  review     Review?

  @@index([userId, experienceId, eventType])
  @@map("interactions")
}

model RecommendationLog {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String?  @map("user_id") @db.Uuid
  locationHash       String   @map("location_hash") // Anonymized coarse area/geohash, NEVER raw GPS
  city               String?
  budgetBand         String?  @map("budget_band")
  categories         String[] @default([])
  candidatesReturned String[] @map("candidates_returned") // Array of experience UUIDs
  chosenId           String?  @map("chosen_id") @db.Uuid
  aiExplanationUsed  Boolean  @default(false) @map("ai_explanation_used")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([locationHash])
  @@index([createdAt])
  @@map("recommendation_logs")
}

// ─── TripSession ────────────────────────────────────────────────────────────
// Ephemeral-by-intent but persisted for resumability and analytics.
// Abandoned session precise GPS is purged by the cleanup cron after
// SESSION_ABANDON_HOURS inactivity (see trip-session.cleanup.service.ts).
model TripSession {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String            @map("user_id") @db.Uuid
  status                   TripSessionStatus @default(ACTIVE)

  // Locations — precise GPS needed for active session functionality.
  // NEVER written to RecommendationLog in raw form; use coarsenLocation() before any log write.
  startLocation            Unsupported("geography(Point,4326)") @map("start_location")
  currentLocation          Unsupported("geography(Point,4326)") @map("current_location")

  startTime                DateTime          @map("start_time")
  remainingTimeMinutes     Int               @map("remaining_time_minutes")
  totalBudget              Float             @map("total_budget")
  remainingBudget          Float             @map("remaining_budget")
  groupSize                Int               @default(1) @map("group_size")
  accessibilityRequirements String[]         @default([]) @map("accessibility_requirements")
  interests                Category[]        @default([])

  // Ordered list of selected experience UUIDs
  selectedExperienceIds    String[]          @default([]) @map("selected_experience_ids") @db.Uuid
  selectedCategories       Category[]        @default([]) @map("selected_categories")

  // Rejection data — SESSION-SCOPED ONLY.
  // TODO(consent): Do NOT promote rejectedCategories to TravelerProfile.interests without
  // a separate explicit opt-in consent flow (DPDP compliance).
  rejectedExperienceIds    String[]          @default([]) @map("rejected_experience_ids") @db.Uuid
  rejectedCategories       Category[]        @default([]) @map("rejected_categories")

  lastActivityAt           DateTime          @default(now()) @map("last_activity_at")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([lastActivityAt]) // used by cleanup cron
  @@map("trip_sessions")
}
