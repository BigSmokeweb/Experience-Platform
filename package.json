{
  "name": "local-experience-intelligence-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Local Experience Intelligence Platform (Traveler & Provider Marketplace)",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=@experience-platform/shared && npm run build --workspace=@experience-platform/frontend",
    "build:all": "npm run build --workspace=shared && npm run db:generate --workspace=backend && npm run build --workspaces",
    "test": "npm run build --workspace=shared && npm run test --workspaces",
    "test:cov": "npm run test:cov --workspace=backend",
    "lint": "npm run lint --workspaces",
    "audit:ci": "npm audit --audit-level=critical",
    "docker:up": "docker-compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infra/docker-compose.yml down",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:push": "npm run db:push --workspace=backend",
    "db:auth:push": "npm run db:push --workspace=backend",
    "db:media:push": "npm run db:media:push --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "db:studio:auth": "npm run db:studio --workspace=backend",
    "db:studio:media": "npm run db:studio:media --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend"
  },
  "keywords": [
    "marketplace",
    "recommendation-engine",
    "postgis",
    "ai-reasoning",
    "experience-intelligence"
  ],
  "author": "Engineering Team",
  "license": "UNLICENSED"
}
